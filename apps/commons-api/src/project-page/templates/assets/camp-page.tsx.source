"use client";
import {useEffect,useState} from 'react';
import maker from '../assets/makers.png';
import nodeLogo from '../assets/node.png';
import settings from './camp.config.json';
import {openChat,pageContext} from '@agent-commons/page';
import './globals.css';
const src=(image:unknown)=>typeof image==='string'?image:(image as {src:string}).src;
const facts=[['9–11 Dec','Wednesday–Friday'],['9:30–12:30','Three mornings'],['Ages 7–13','Curious minds welcome']];
const questions=[['Whose is it?','Respect other people’s work.'],['Is it true?','Check facts, stories and results.'],['Who could it hurt?','Think about privacy and feelings.'],['Where am I in it?','Keep your own ideas and choices.']];
export default function CampPage(){
 const [chat,setChat]=useState(false);const [error,setError]=useState('');
 useEffect(()=>setChat(pageContext().chatEnabled),[]);
 const formUrl=/^https:\/\/(?:docs\.google\.com\/forms\/|forms\.gle\/)/.test(settings.registrationUrl)?settings.registrationUrl:'';
 const faq=[
 ['What will my child make?','In the creative path, children develop a 6–8 panel comic, a short film or a trailer of about 30 seconds. In the building path, they create a simple browser game, interactive story or useful mini app, then test and improve it.'],
 ['Do we choose an activity now?','You can share a preference when registering. The first morning is shared; the making paths begin on Day 2. The team will confirm grouping and available space.'],
 ['Does my child need experience or an AI account?','This is an introductory making experience. Children start with drawings, words and ideas on paper. They do not create AI-service accounts. Tell the team privately about support that would help your child participate.'],
 ['What does the fee cover?','The confirmed fee is KSh 5,000 per child for all three mornings. The organiser will share the confirmed equipment, materials, food arrangements and cancellation terms before requesting payment.'],
 ['What about photos, privacy and consent?','Guardian information and choices are collected during enrolment. Local voice recording, the closed family showcase, public project sharing and publicity have separate choices. Declining an optional use does not affect participation; children’s wishes matter too.'],
 ['Can families see what the children have made?',settings.showcaseTime?`The final-day family showcase is on Friday 11 December, ${settings.showcaseTime}. The organiser will share guest and collection arrangements.`:'A family showcase is planned for Friday 11 December. The exact invitation time and guest arrangements will follow with joining information.'],
 ['How is a place confirmed?','Register your interest first. The team checks space, sends a written offer, and then reviews enrolment, required permissions and payment. A place is confirmed separately by the organiser.'],
 ];
 return <main className="camp-site">
  <a className="camp-skip" href="#programme">Skip to the programme</a>
  <header className="camp-nav"><a href="#top" aria-label="AI Kids Hacker Camp home"><img className="camp-logo" src={src(nodeLogo)} alt="NODE NBO"/></a><nav aria-label="Camp navigation"><a href="#programme">The programme</a><a href="#make">What we’ll make</a><a href="#parents">For parents</a></nav><a className="camp-nav-action" href="#join">Join the camp <span aria-hidden>↗</span></a></header>
  <section className="camp-hero camp-wrap" id="top">
   <div className="camp-hero-copy"><p className="camp-eyebrow">December holiday camp · Nairobi</p><h1>AI Kids<br/>Hacker Camp<span className="camp-title-dot">.</span></h1><p className="camp-hero-line">A story to tell.<br/>A game to build.</p><p className="camp-lead">Three mornings for curious minds to turn their ideas into comics, films, games and simple apps.</p><a className="camp-button" href="#programme">Explore the camp <span aria-hidden>↓</span></a></div>
   <div className="camp-hero-art"><span className="camp-orbit camp-orbit-one" aria-hidden/><span className="camp-art-label">Create · Code · Play</span><img src={src(maker)} alt="Two young makers developing a storyboard and a project at a shared table" fetchPriority="high"/><span className="camp-doodle" aria-hidden>✦</span></div>
  </section>
  <section className="camp-facts camp-wrap" aria-label="Camp details">{facts.map(([large,small])=><div key={large}><strong>{large}</strong><span>{small}</span></div>)}<div><strong>NODE NBO</strong><span>Gigiri, Nairobi</span></div></section>
  <section className="camp-section camp-wrap" id="make"><p className="camp-eyebrow">Choose your making path</p><div className="camp-heading-row"><h2>Big ideas.<br/>Made by you.</h2><p>Start with an idea on paper.<br/>Work together. Make decisions.<br/>See what you can bring to life.</p></div>
   <div className="camp-tracks"><article className="camp-track camp-create"><div className="camp-track-mark" aria-hidden><svg viewBox="0 0 100 70"><rect x="5" y="7" width="90" height="56" rx="4"/><path d="M35 7v56M65 7v56M5 35h90"/><path d="m14 27 7-12 7 12M45 20h10M75 19l10 6-10 6"/></svg></div><p className="camp-track-type">Create with AI</p><h3>Comics &<br/>filmmaking</h3><p>Invent a character. Draw a storyboard. Turn your story into a comic, short film or trailer.</p><ul><li>Original stories & characters</li><li>Storyboards & visual choices</li><li>Comics, films & trailers</li></ul><span className="camp-track-note">Your imagination sets the direction.</span></article>
   <article className="camp-track camp-build"><div className="camp-track-mark" aria-hidden><svg viewBox="0 0 100 70"><rect x="5" y="7" width="90" height="56" rx="4"/><path d="M5 20h90M15 13h2m5 0h2m5 0h2M35 31l-10 10 10 10m30-20 10 10-10 10M55 29l-10 24"/></svg></div><p className="camp-track-type">Build with AI</p><h3>Games &<br/>simple apps</h3><p>Sketch something that works. Build a small game, interactive story or mini app, then put it to the test.</p><ul><li>Paper prototypes & clear rules</li><li>Simple working interactions</li><li>Testing, fixing & trying again</li></ul><span className="camp-track-note">The best part? Making it work.</span></article></div>
  </section>
  <section className="camp-programme" id="programme"><div className="camp-wrap"><p className="camp-eyebrow">9–11 December 2026</p><div className="camp-heading-row"><h2>Three days.<br/>A whole lot of making.</h2><p>9:30 am–12:30 pm each day.<br/>One shared beginning.<br/>Two ways to follow your curiosity.</p></div><ol className="camp-days"><li><span className="camp-day-number">01</span><p className="camp-day-date">Wednesday · 9 December</p><h3>Explore together.</h3><p>Meet the ideas behind AI, ask good questions and discover what makes something your own. Start on paper.</p></li><li><span className="camp-day-number">02</span><p className="camp-day-date">Thursday · 10 December</p><h3>Choose. Sketch. Make.</h3><p>Choose comics & filmmaking or games & apps. Share the roles, develop an idea and make a first version.</p></li><li><span className="camp-day-number">03</span><p className="camp-day-date">Friday · 11 December</p><h3>Test it. Share it.</h3><p>Improve the work, explain your choices and show what you’ve made at the final-day family showcase.</p></li></ol></div></section>
  <section className="camp-section camp-wrap camp-human"><div><p className="camp-eyebrow">People in charge</p><h2>Their ideas.<br/>Their choices.</h2><p className="camp-lead">AI can help make things.<br/>Children decide what matters.</p><p>We practise four questions while creating, building and checking our work.</p></div><div className="camp-questions">{questions.map(([q,a],i)=><div key={q}><span>0{i+1}</span><div><h3>{q}</h3><p>{a}</p></div></div>)}</div></section>
  <section className="camp-parents" id="parents"><div className="camp-wrap"><p className="camp-eyebrow">A little clarity for grown-ups</p><h2>Questions, answered.</h2><div className="camp-faq">{faq.map(([q,a])=><details key={q}><summary>{q}<span aria-hidden>+</span></summary><p>{a}</p></details>)}</div></div></section>
  <section className="camp-section camp-wrap camp-join" id="join"><div><p className="camp-eyebrow">Your next December adventure</p><h2>Bring your curiosity.<br/>We’ll make a start.</h2><p>9–11 December · 9:30 am–12:30 pm<br/>NODE NBO, Gigiri · Ages 7–13</p></div><div className="camp-join-card"><div className="camp-fee"><strong>KSh 5,000</strong><span>per child<br/>all three days</span></div>{formUrl?<><a className="camp-button" href={formUrl} target="_blank" rel="noopener noreferrer">Register your interest <span aria-hidden>↗</span></a><p className="camp-small">Opens the parent / guardian interest form. The organiser confirms places separately.</p></>:<><p className="camp-registration-note">Registration opens soon.</p><a className="camp-text-link" href="#parents">Read the parent questions <span aria-hidden>↗</span></a></>}{settings.bookingContact&&<p className="camp-small">Questions? {settings.bookingContact}</p>}</div></section>
  <footer className="camp-footer camp-wrap"><img className="camp-logo" src={src(nodeLogo)} alt="NODE NBO"/><p>AI Kids Hacker Camp<br/><span>Nairobi · December 2026</span></p>{chat&&<div><button onClick={()=>{setError('');void openChat().catch(e=>setError(e.message));}} className="camp-text-link">Ask in Commons ↗</button>{error&&<p role="alert" className="camp-small">{error}</p>}</div>}</footer>
 </main>;
}
