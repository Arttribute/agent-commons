{
  "name": "commons-desktop",
  "version": "0.3.2",
  "private": true,
  "author": "Agent Commons",
  "type": "module",
  "description": "Agent Commons desktop — cloud and private-local workspaces",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "pnpm build:commons-app && pnpm build:main && electron .",
    "build:main": "tsup",
    "build": "pnpm build:main",
    "build:commons-app": "cross-env COMMONS_DESKTOP_BUNDLE_APP=1 pnpm --filter commons-app build && node scripts/bundle-commons-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.mjs",
    "smoke": "node scripts/smoke-unified-app.mjs",
    "start": "electron .",
    "package": "pnpm build:commons-app && pnpm build && electron-builder",
    "package:dir": "pnpm build:commons-app && pnpm build && electron-builder --dir"
  },
  "devDependencies": {
    "@agent-commons/agent-core": "workspace:*",
    "@agent-commons/desktop-contract": "workspace:*",
    "@agent-commons/cli": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.2",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "io.agentcommons.desktop",
    "productName": "Agent Commons",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "artifactName": "Agent-Commons-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      { "from": "commons-app-dist", "to": "commons-app" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "Arttribute",
      "repo": "agent-commons",
      "releaseType": "release"
    }
  }
}
