{
  "name": "commons-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Agent Commons",
  "type": "module",
  "description": "Agent Commons desktop — cloud and private-local workspaces",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.ts\" \"tsup --watch\" \"wait-on tcp:4173 dist/main.cjs && cross-env COMMONS_DESKTOP_DEV_URL=http://127.0.0.1:4173 electron .\"",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsup",
    "build": "pnpm build:renderer && pnpm build:main",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir"
  },
  "devDependencies": {
    "@agent-commons/desktop-contract": "workspace:*",
    "@agent-commons/cli": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.2",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "io.agentcommons.desktop",
    "productName": "Agent Commons",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "artifactName": "Agent-Commons-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "Arttribute",
      "repo": "agent-commons",
      "releaseType": "release"
    }
  }
}
