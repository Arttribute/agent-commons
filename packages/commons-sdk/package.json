{
  "name": "@agent-commons/sdk",
  "version": "0.6.0",
  "description": "Official TypeScript SDK for building, running, and managing agents on Agent Commons",
  "license": "MIT",
  "keywords": [
    "agent-commons",
    "ai-agents",
    "agent-sdk",
    "typescript",
    "workflows",
    "mcp",
    "a2a"
  ],
  "homepage": "https://docs.agentcommons.io/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arttribute/agent-commons.git",
    "directory": "packages/commons-sdk"
  },
  "bugs": {
    "url": "https://github.com/Arttribute/agent-commons/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  }
}
