{
  "name": "@agent-commons/cli",
  "version": "0.3.0",
  "description": "Official Agent Commons CLI for building, running, and managing AI agents from the terminal",
  "license": "MIT",
  "keywords": [
    "agent-commons",
    "ai-agents",
    "cli",
    "terminal",
    "workflows",
    "mcp",
    "automation"
  ],
  "homepage": "https://docs.agentcommons.io/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arttribute/agent-commons.git",
    "directory": "packages/agc-cli"
  },
  "bugs": {
    "url": "https://github.com/Arttribute/agent-commons/issues"
  },
  "preferGlobal": true,
  "bin": {
    "agc": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-commons/sdk": "workspace:*",
    "@types/pdf-parse": "^1.1.5",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
